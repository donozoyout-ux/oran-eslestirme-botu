# mock: API anahtari gerektirmeden ornek veriyle calisir
# the_odds_api: The Odds API
# betexplorer_scraper: herkese acik BetExplorer tablolarini tarar
ODDS_PROVIDER=betexplorer_scraper
ALLOW_MOCK_IN_PRODUCTION=false
ODDS_API_KEY=

# Vercel sadece arayuz/proxy olarak kullaniliyorsa Railway public servis adresi.
# Ornek: https://oran-botu-production.up.railway.app
BACKEND_URL=

# Opsiyonel ek kaynaklar. Anahtarlar yalnizca gizli ortam degiskenlerine girilmeli.
# API-Football: gunluk fikstur katalogu bir kez alinir; sadece Big Five ust ligleri tutulur.
API_FOOTBALL_KEY=
API_FOOTBALL_MAX_FIXTURES=2
API_FOOTBALL_FIXTURE_CACHE_MINUTES=30
API_FOOTBALL_PREMATCH_CACHE_MINUTES=120
API_FOOTBALL_LIVE_CACHE_MINUTES=10
API_FOOTBALL_DAILY_REQUEST_BUDGET=80

# football-data.org: sadece Premier League, La Liga, Bundesliga, Serie A, Ligue 1 dogrulamasi.
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_COMPETITIONS=PL,PD,BL1,SA,FL1
FOOTBALL_DATA_CACHE_MINUTES=30
FOOTBALL_DATA_DAILY_REQUEST_BUDGET=30

# The Odds API: sadece Big Five; normal modda son-care prematch fallback.
SPORT_KEYS=soccer_epl,soccer_spain_la_liga,soccer_germany_bundesliga,soccer_italy_serie_a,soccer_france_ligue_one
BOOKMAKER_KEYS=pinnacle,betfair_ex_eu,betfair,bet365
REGIONS=eu,uk

# BetExplorer: sadece Big Five ana prematch/web-scraping oran kaynagi.
SCRAPER_MAX_MATCHES=2
SCRAPER_PAGE_TIMEOUT_MS=60000
SCRAPER_WAIT_MS=2500
SCRAPER_ALLOW_VISIBLE_BOOKMAKER_FALLBACK=true
CHROMIUM_EXECUTABLE_PATH=

# Gunluk plan: fikstur bir kez kaydedilir; oran taramasi mac saatine yaklastikca siklasir.
PREMATCH_TRACK_HOURS=6
PREMATCH_FAR_POLL_MINUTES=60
PREMATCH_NEAR_POLL_MINUTES=15
PREMATCH_FINAL_POLL_MINUTES=5
LIVE_POLL_MINUTES=3

# Telegram'a yakin oran alarmi sadece son 20 dakikada, en az 3 kaynak ve yuksek guvenle gider.
PREMATCH_ALERT_WINDOW_MINUTES=20
PREMATCH_ALERT_MIN_SOURCES=3
PREMATCH_ALERT_MIN_CONFIDENCE=70

ODDS_TOLERANCE_PERCENT=2
POLL_INTERVAL_SECONDS=60
MAX_QUOTE_AGE_SECONDS=300
MAX_LIVE_EVENT_AGE_MINUTES=180
ALERT_COOLDOWN_SECONDS=600
SURPRISE_ODDS_THRESHOLD=2.5
ODDS_MOVEMENT_THRESHOLD_PERCENT=8

# Telegram bilgilerini Git'e eklemeyin. Gercek bildirim icin DRY_RUN=false olmali.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DRY_RUN=false

PORT=3000
ADMIN_TOKEN=
STATE_FILE=./data/alert-state.json
DAILY_SHEET_FILE=./data/daily-match-sheet.json

# Opsiyonel Google Sheets aynasi. Ozel anahtari Git'e veya mesaja yazmayin.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SYNC_MINUTES=1
